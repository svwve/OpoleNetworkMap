<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane fx:controller="com.example.backend.MapController" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="main-background" style="-fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <left>
        <VBox spacing="10" styleClass="sidebar" prefWidth="280" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e2e8f0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>

            <!-- Nawigacja górna -->
            <Button fx:id="btnBackToMenu" text="← Menu Projektów" onAction="#handleBackToMenu" maxWidth="Infinity" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8; -fx-cursor: hand;"/>

            <Separator style="-fx-opacity: 0.4;" />

            <!-- Główne akcje dodawania -->
            <VBox spacing="6">
                <Button fx:id="btnAddCamera" text="📷 Dodaj Kamerę" onAction="#handleAddCamera" maxWidth="Infinity" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8; -fx-cursor: hand;"/>
                <Button fx:id="btnAddFiber" text="🔌 Dodaj Światłowód" onAction="#handleAddFiber" maxWidth="Infinity" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8; -fx-cursor: hand;"/>
            </VBox>

            <!-- Pasek narzędzi edycji światłowodów -->
            <VBox spacing="6" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                <Label text="Edycja światłowodu:" style="-fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                <HBox spacing="6">
                    <Button fx:id="btnUndoFiber" text="↩️ Cofnij" onAction="#handleUndoFiberChange" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #ea580c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 11px; -fx-cursor: hand;" />
                    <Button fx:id="btnDeleteVertex" text="❌ Usuń punkt" onAction="#handleEnableVertexDeletion" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 11px; -fx-cursor: hand;" />
                </HBox>
                <Button fx:id="btnAppendFromEnd" text="✏️ Dorysuj / Edytuj" onAction="#handleAppendFromEnd" maxWidth="Infinity" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 11px; -fx-cursor: hand;"/>
                <Button fx:id="btnEditFiber" text="🛠 Styl światłowodu" onAction="#handleEditFiber" maxWidth="Infinity" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 11px; -fx-cursor: hand;"/>
                <Button fx:id="btnFinishFiber" text="✓ Zapisz zmiany" onAction="#handleFinishFiber" maxWidth="Infinity" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8; -fx-cursor: hand;" wrapText="true" textAlignment="CENTER"/>
            </VBox>

            <!-- Lista elementów -->
            <ListView fx:id="elementList" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />

            <!-- Widoczność -->
            <VBox spacing="4" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                <Label text="Widoczność:" style="-fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                <CheckBox fx:id="toggleCameraVisibilityCheckBox" text="📷 Kamery" selected="true" onAction="#handleToggleCameraVisibility" style="-fx-font-size: 12px;"/>
                <CheckBox fx:id="toggleFiberVisibilityCheckBox" text="🔌 Światłowody" selected="true" onAction="#handleToggleFiberVisibility" style="-fx-font-size: 12px;"/>
            </VBox>

            <Separator style="-fx-opacity: 0.4;" />

            <!-- Zarządzanie elementami i projektem -->
            <VBox spacing="6">
                <Button fx:id="btnRename" text="📝 Zmień Nazwę" onAction="#handleRename" maxWidth="Infinity" style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-cursor: hand;"/>
                <Button fx:id="btnDelete" text="🗑 Usuń Element" onAction="#handleDelete" maxWidth="Infinity" style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-cursor: hand;"/>
                <Button text="💾 Zapisz Sieć" onAction="#handleSaveData" maxWidth="Infinity" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="map-container">
            <BorderPane.margin>
                <Insets left="16"/>
            </BorderPane.margin>

            <WebView fx:id="webView" style="-fx-background-radius: 12; -fx-border-radius: 12;" />
        </StackPane>
    </center>
</BorderPane>
