<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16" style="-fx-background-color: #f4f6f9; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.backend.RegisterController">
    <padding>
        <Insets top="35" right="40" bottom="35" left="40" />
    </padding>

    <!-- Nagłówek -->
    <VBox alignment="CENTER" spacing="4">
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Rejestracja" />
        <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Utwórz nowe konto użytkownika" />
    </VBox>

    <!-- Formularz -->
    <VBox alignment="CENTER" spacing="10" maxWidth="280">
        <TextField fx:id="usernameField" promptText="Nazwa użytkownika" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 9; -fx-font-size: 13px;" />
        <PasswordField fx:id="passwordField" promptText="Hasło" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 9; -fx-font-size: 13px;" />
        <PasswordField fx:id="confirmPasswordField" promptText="Powtórz hasło" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 9; -fx-font-size: 13px;" />

        <ComboBox fx:id="roleComboBox" promptText="Wybierz rolę" maxWidth="Infinity" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 4; -fx-font-size: 13px;" />

        <Label fx:id="messageLabel" visible="false" style="-fx-font-size: 12px;" wrapText="true" alignment="CENTER"/>

        <!-- Przyciski -->
        <Button text="Zarejestruj się" onAction="#handleRegister" maxWidth="Infinity" defaultButton="true" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10; -fx-font-size: 13px; -fx-cursor: hand;" />
        <Button text="← Powrót do logowania" onAction="#handleBackToLogin" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-padding: 6; -fx-font-size: 12px; -fx-cursor: hand;" />
    </VBox>
</VBox>
