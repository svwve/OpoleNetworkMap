<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane fx:controller="com.example.backend.MapController" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="main-background">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <left>
        <VBox spacing="12" styleClass="sidebar">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>

            <!-- Pasek narzędzi edycji światłowodów (Cofnij i Usuń wierzchołek) -->
            <HBox spacing="8">
                <Button fx:id="btnUndoFiber"
                        text="↩️ Cofnij"
                        onAction="#handleUndoFiberChange"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold;" />

                <Button fx:id="btnDeleteVertex"
                        text="❌ Usuń punkt"
                        onAction="#handleEnableVertexDeletion"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;" />
            </HBox>

            <Button fx:id="btnBackToMenu" text="← Menu Projektów" onAction="#handleBackToMenu" maxWidth="Infinity" styleClass="btn, btn-grey"/>

            <Button fx:id="btnAddCamera" text="📷 Dodaj Kamerę" onAction="#handleAddCamera" maxWidth="Infinity" styleClass="btn, btn-white"/>
            <Button fx:id="btnAddFiber" text="🔌 Dodaj Światłowód" onAction="#handleAddFiber" maxWidth="Infinity" styleClass="btn, btn-white"/>

            <Button fx:id="btnFinishFiber" text="✓ Zapisz zmiany" onAction="#handleFinishFiber" maxWidth="Infinity" styleClass="btn, btn-green" wrapText="true" textAlignment="CENTER"/>

            <Button text="💾 Zapisz Sieć" onAction="#handleSaveData" maxWidth="Infinity" styleClass="btn, btn-black"/>

            <ListView fx:id="elementList" VBox.vgrow="ALWAYS" styleClass="custom-list"/>

            <Button fx:id="btnEditFiber" text="🛠 Edytuj Kolor i grubość światłowodu" onAction="#handleEditFiber" maxWidth="Infinity" styleClass="btn, btn-grey"/>
            <Button fx:id="btnAppendFromEnd" text="✏️ Edytuj / Dorysuj światłowód " onAction="#handleAppendFromEnd" maxWidth="Infinity" styleClass="btn, btn-grey"/>

            <VBox spacing="5" styleClass="visibility-box">
                <padding>
                    <Insets top="5" bottom="5"/>
                </padding>
                <Label text="Widoczność:" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                <CheckBox fx:id="toggleCameraVisibilityCheckBox" text="📷 Pokaż Kamery" selected="true" onAction="#handleToggleCameraVisibility"/>
                <CheckBox fx:id="toggleFiberVisibilityCheckBox" text="🔌 Pokaż Światłowody" selected="true" onAction="#handleToggleFiberVisibility"/>
            </VBox>

            <Button fx:id="btnRename" text="📝 Zmień Nazwę" onAction="#handleRename" maxWidth="Infinity" styleClass="btn, btn-grey"/>
            <Button fx:id="btnDelete" text="🗑 Usuń Element" onAction="#handleDelete" maxWidth="Infinity" styleClass="btn, btn-danger"/>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="map-container">
            <BorderPane.margin>
                <Insets left="20"/>
            </BorderPane.margin>

            <WebView fx:id="webView" />
        </StackPane>
    </center>
</BorderPane>
