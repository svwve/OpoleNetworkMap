<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="24" style="-fx-background-color: #0f172a; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.backend.LoginController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30" />
    </padding>

    <!-- Główna karta logowania -->
    <VBox alignment="CENTER" maxWidth="340" spacing="20" style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-padding: 32; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 20, 0, 0, 4);">

        <!-- Nagłówek i wersja -->
        <VBox alignment="CENTER" spacing="6">
            <Label fx:id="versionLabel" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" text="Sprawdzanie aktualizacji..." />
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Opole Network" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Zaloguj się do swojego konta" />
        </VBox>

        <!-- Pola formularza -->
        <VBox alignment="CENTER" spacing="12" maxWidth="Infinity">
            <VBox spacing="4" maxWidth="Infinity">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="NAZWA UŻYTKOWNIKA" />
                <TextField fx:id="usernameField" promptText="Wpisz login" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 11; -fx-font-size: 13px;" />
            </VBox>

            <VBox spacing="4" maxWidth="Infinity">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="HASŁO" />
                <PasswordField fx:id="passwordField" promptText="Wpisz hasło" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 11; -fx-font-size: 13px;" />
            </VBox>

            <Label fx:id="errorLabel" visible="false" style="-fx-text-fill: #ef4444; -fx-font-size: 12px; -fx-font-weight: bold;" wrapText="true" alignment="CENTER"/>
        </VBox>

        <!-- Przyciski akcji -->
        <VBox alignment="CENTER" spacing="10" maxWidth="Infinity">
            <Button text="Zaloguj się" onAction="#handleLogin" maxWidth="Infinity" defaultButton="true" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 13px; -fx-cursor: hand;" />
            <Button text="Stwórz nowe konto" onAction="#handleOpenRegister" maxWidth="Infinity" style="-fx-background-color: #f1f5f9; -fx-text-fill: #2563eb; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 13px; -fx-cursor: hand;" />
        </VBox>
    </VBox>
</VBox>
